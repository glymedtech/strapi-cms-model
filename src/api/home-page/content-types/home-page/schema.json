      "allowedTypes": [
        "images"
      ]
    },
    "skinProfileButtonText": {
      "type": "string"
    },
    "skinProfileButtonLink": {
      "type": "string"
    },
    "fourStepSystemLabel": {
      "type": "string"
    },
    "fourStepSystemTitle": {
      "type": "component",
      "component": "shared.text-with-color",
      "repeatable": false
    },
    "fourStepSystemDescription": {
      "type": "component",
      "component": "shared.text-with-color",
      "repeatable": false
